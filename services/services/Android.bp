package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

java_library {
    name: "tv-services",
    installable: true,
    system_ext_specific: true,
    platform_apis: true,

    // The convention is 'tv-services.$(module_name)-srcs'
    srcs: [
        ":tv-services.input-srcs",
        ":tv-services.watchdogservice-srcs",
        ":tv-services-dump-proto",
    ],

    libs: [
        // Use `services.impl` to avoid a dependency cycle when tracing
        // references that feed into `services` during dex optimization.
        "services.impl",
        "framework",
        "tv-resources",
    ],

    static_libs: [
        "android.automotive.watchdog.internal-java",
        "tv-services-atoms-java-lite",
        "tv-services-client.impl",
    ],

    jarjar_rules: "jarjar-rules.txt",

    required: [
        "TvServicesOverlay",
        "tv-resources",
    ],

    optimize: {
        enabled: true,
        optimize: true,
        shrink: true,
        proguard_flags_files: [
            "proguard.flags",
        ],
        ignore_warnings: false,
    },
}
