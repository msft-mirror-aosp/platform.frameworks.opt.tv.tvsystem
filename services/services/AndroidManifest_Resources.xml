<!-- Manifest for tv-services resources APK -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.android.tv.services">

    <!--
      Permission required for the TvWatchdogService to post its
      resource overuse notification to the user.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!--
      hasCode="false" indicates this is a resource-only package.
      directBootAware="true" allows system services to access these resources
      even before the user has unlocked the device for the first time.
    -->
    <application
        android:directBootAware="true"
        android:hasCode="false">
    </application>

</manifest>
