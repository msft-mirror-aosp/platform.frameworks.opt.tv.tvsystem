package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

filegroup {
    name: "tv-services.input-srcs",
    srcs: [
        "src/**/*.java",
        ":tv-services.input-interface-aidl-java-source",
    ],
}

aidl_interface {
    name: "tv-services.input-interface-aidl",
    vendor_available: false,
    owner: "google",
    host_supported: true,
    frozen: false,
    srcs: ["src/**/*.aidl"],
    local_include_dir: "src",
    unstable: true,
    backend: {
        cpp: {
            enabled: false,
        },
        java: {
            sdk_version: "current",
        },
        ndk: {
            enabled: false,
        },
    },
}
