package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// Defines the new test module for TvWatchdogService unit tests.
android_test {
    name: "TvServicesUnitTests",

    srcs: ["src/**/*.java"],

    manifest: "AndroidManifest.xml",

    // Grant access to internal APIs.
    platform_apis: true,

    static_libs: [
        "tv-services",

        "services.core",
        "frameworks-base-testutils",

        "testables",
        "android.test.base.stubs",

        "junit",
        "mockito-target-minus-junit4",
        "truth",
        "guava",

        "androidx.test.core",
        "androidx.test.ext.junit",
        "androidx.test.rules",
        "androidx.test.runner",

        "platform-test-annotations",
        "servicestests-utils",
    ],

    libs: [
        "android.test.base.impl",
        "android.test.runner.impl",
        "android.test.mock.impl",
    ],

    test_suites: [
        "device-tests",
    ],

    // Required for platform tests.
    certificate: "platform",

}
