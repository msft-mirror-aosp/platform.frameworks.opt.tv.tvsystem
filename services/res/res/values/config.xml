<!-- These resources are around just to allow their values to be customized
for different hardware and product builds.  Do not translate. -->

<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- The number of top UID I/O usage summaries to report on TV watchdog I/O usage
         summary atom pull. -->
    <integer name="config_tvWatchdogUidIoUsageSummaryTopCount">20</integer>

    <!-- The minimum number of total bytes written to disk by the system required to
         report the stats on TV watchdog I/O usage summary atom pull. Currently 1 GiB. -->
    <integer name="config_tvWatchdogIoUsageSummaryMinSystemTotalWrittenBytes">1073741824</integer>

    <!-- The number of days past until the current day considered by TV watchdog to
         reset the killable state of a package back to KILLABLE_STATE_YES if the package
         was set to prioritize performance by the user. -->
    <integer name="config_tvWatchdogUserPackageSettingsResetDays">30</integer>

    <!-- The number of days past until the current day considered by TV watchdog to
         attribute recurring overuse to a package. -->
    <integer name="config_tvWatchdogRecurringOverusePeriodInDays">30</integer>

    <!-- The number of overuses a package has to exceed for TV watchdog to attribute
         recurring overuse. Allow many recurring overuses (effectively disabling kill logic). -->
    <integer name="config_tvWatchdogRecurringOveruseTimes">100</integer>
</resources>
