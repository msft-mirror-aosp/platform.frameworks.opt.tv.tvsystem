<resources xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="tv_watchdog_notification_channel_name" msgid="8971059672663350083">"ಸಿಸ್ಟಮ್ ಸಂಪನ್ಮೂಲಕ್ಕೆ ಸಂಬಂಧಿಸಿದ ಎಚ್ಚರಿಕೆಗಳು"</string>
    <string name="tv_watchdog_notification_title" msgid="7968616737208486478">"ಸಂಪನ್ಮೂಲಗಳನ್ನು ಮಿತಿಮೀರಿ ಬಳಸಲಾಗುತ್ತಿದೆ"</string>
    <string name="tv_watchdog_notification_content" msgid="966333295117219246">"ಅತಿಯಾದ ಸಂಪನ್ಮೂಲ ಬಳಕೆಯಿಂದಾಗಿ ಆ್ಯಪ್‌ \'<xliff:g id="APP_NAME">%1$s</xliff:g> ಅನ್ನು ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಲಾಗಿದೆ. ನೀವು ಅದನ್ನು ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿನ ಆ್ಯಪ್‌ಗಳ ಮೆನುವಿನಿಂದ ಮರು-ಸಕ್ರಿಯಗೊಳಿಸಬಹುದು.\""</string>
</resources>
