    <string name="tv_watchdog_notification_channel_name" msgid="8971059672663350083">"சிஸ்டம் ஆதாரம் தொடர்பான விழிப்பூட்டல்கள்"</string>
    <string name="tv_watchdog_notification_title" msgid="7968616737208486478">"ஆதாரத்தை அதிகளவில் பயன்படுத்துதல்"</string>
    <string name="tv_watchdog_notification_content" msgid="966333295117219246">"அதிகப்படியான ஆதாரங்களைப் பயன்படுத்தியதால் <xliff:g id="APP_NAME">%1$s</xliff:g> ஆப்ஸ் ஆஃப் செய்யப்பட்டுள்ளது. அமைப்புகளுக்குச் சென்று ஆப்ஸ் மெனுவில் அதை மீண்டும் ஆன் செய்யலாம்."</string>
</resources>
